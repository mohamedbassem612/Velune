+            val used = perArtist[key] ?: 0
+            if (used >= 2) continue
+            perArtist[key] = used + 1
+            result += song
+            if (result.size >= 20) break
+        }
+        if (result.size < 20) {
+            val chosen = result.map { it.id }.toHashSet()
+            for (song in ranked) {
