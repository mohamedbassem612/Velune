cmake_minimum_required(VERSION 3.21)
foreach(required BENCHMARK FIXTURE_DIR OUTPUT_DIR)
 if(NOT ${required})
  message(FATAL_ERROR "Pass -D${required}=<path>")
 endif()
endforeach()
if(NOT ITERATIONS)
 set(ITERATIONS 30)
endif()
if(NOT SCENARIOS)
 set(SCENARIOS cold warm switch seek)
endif()
if(NOT BACKENDS)
 set(BACKENDS qt mpv)
endif()
file(MAKE_DIRECTORY "${OUTPUT_DIR}")
set(failures "")
foreach(format mp3 m4a opus flac wav mp4)
  if(format STREQUAL "mp4")
   set(fixture "${FIXTURE_DIR}/audio-video.mp4")
  else()
   set(fixture "${FIXTURE_DIR}/tone.${format}")
  endif()
  foreach(transport file relay)
   foreach(scenario IN LISTS SCENARIOS)
    foreach(backend IN LISTS BACKENDS)
    set(name "${backend}-${format}-${transport}-${scenario}")
    set(args --backend "${backend}" --fixture "${fixture}" --transport "${transport}"
      --scenario "${scenario}" --iterations "${ITERATIONS}" --output "${OUTPUT_DIR}/${name}.json")
    if(RESOLVER_FIXTURE)
     list(APPEND args --resolver-fixture "${RESOLVER_FIXTURE}")
    endif()
    if(AUDIO_DEVICE)
     list(APPEND args --audio-device "${AUDIO_DEVICE}")
    endif()
    message(STATUS "Benchmark ${name}")
    execute_process(COMMAND "${BENCHMARK}" ${args} RESULT_VARIABLE result
      OUTPUT_FILE "${OUTPUT_DIR}/${name}.stdout.log" ERROR_FILE "${OUTPUT_DIR}/${name}.stderr.log")
    if(NOT result EQUAL 0)
     list(APPEND failures "${name}:${result}")
    endif()
   endforeach()
  endforeach()
 endforeach()
endforeach()
if(failures)
 message(FATAL_ERROR "Benchmark failures (raw results retained): ${failures}")
endif()
