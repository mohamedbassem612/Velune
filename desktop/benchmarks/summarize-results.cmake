cmake_minimum_required(VERSION 3.21)
if(NOT INPUT_DIR OR NOT OUTPUT)
 message(FATAL_ERROR "Pass -DINPUT_DIR=<results-directory> -DOUTPUT=<summary.csv>")
endif()
file(GLOB results "${INPUT_DIR}/*.json")
list(SORT results)
file(WRITE "${OUTPUT}" "backend,format,transport,scenario,metric,samples,median_ms,p95_ms,failures\n")
foreach(path IN LISTS results)
 file(READ "${path}" json)
 foreach(field backend format transport scenario metric failures)
  string(JSON ${field} GET "${json}" ${field})
 endforeach()
 foreach(field samples median_ms p95_ms)
  string(JSON ${field} GET "${json}" summary ${field})
 endforeach()
 file(APPEND "${OUTPUT}" "${backend},${format},${transport},${scenario},${metric},${samples},${median_ms},${p95_ms},${failures}\n")
endforeach()
